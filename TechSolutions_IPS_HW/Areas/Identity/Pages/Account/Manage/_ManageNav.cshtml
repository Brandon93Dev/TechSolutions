@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;

    string ActiveClass(string pagePath)
        => currentPage.Equals(pagePath, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}

<div class="list-group account-manage-nav rounded-4 shadow-sm overflow-hidden">
    <a asp-page="./Index" class="list-group-item list-group-item-action d-flex align-items-center gap-2 @ActiveClass("/Account/Manage/Index")">
        <i class="fa-solid fa-id-card"></i>
        <span>Profile</span>
    </a>
    <a asp-page="./ChangePassword" class="list-group-item list-group-item-action d-flex align-items-center gap-2 @ActiveClass("/Account/Manage/ChangePassword")">
        <i class="fa-solid fa-key"></i>
        <span>Password</span>
    </a>
    <a asp-page="./PersonalData" class="list-group-item list-group-item-action d-flex align-items-center gap-2 @ActiveClass("/Account/Manage/PersonalData")">
        <i class="fa-solid fa-database"></i>
        <span>Personal Data</span>
    </a>
</div>
<!--Tapped in to override built in 2Fa functionality-->
<div class="small text-muted mt-2 px-2">
    Two-factor authentication is disabled for this application.
</div>
