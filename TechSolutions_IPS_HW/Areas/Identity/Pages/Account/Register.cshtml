@page
@model TechSolutions_IPS_HW.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Create Account";
    Layout = "/Views/Shared/_LoginLayout.cshtml";
}

<!--
    Override on microsoft's default built in registration page on the Microsoft Identity functionality
    Needed to tap in here to ensure we can add additional information on registration including username
-->

<div class="card login-card">
    <div class="login-header">
        <i class="bi bi-person-plus-fill d-block"></i>
        <h4 class="mb-0 fw-bold">TechSolutions</h4>
        <small class="opacity-75">Create a New Account</small>
    </div>
    <div class="card-body p-4">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.DisplayName" class="form-control" placeholder="Username" />
                <label asp-for="Input.DisplayName"><i class="bi bi-person me-1"></i>Username</label>
                <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                <label asp-for="Input.Email"><i class="bi bi-envelope me-1"></i>Email address</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Password" />
                <label asp-for="Input.Password"><i class="bi bi-key me-1"></i>Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirm password" />
                <label asp-for="Input.ConfirmPassword"><i class="bi bi-key-fill me-1"></i>Confirm password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button id="registerSubmit" type="submit" class="btn btn-primary btn-login w-100 mb-3">
                <i class="bi bi-person-check me-1"></i>Register
            </button>

            <div class="text-center">
                <a asp-page="./Login" class="small text-decoration-none">Already have an account? Sign in</a>
            </div>
        </form>
    </div>
    <div class="card-footer bg-light text-center py-3" style="border-radius: 0 0 1rem 1rem;">
        <small class="text-muted"><i class="bi bi-shield-check me-1"></i>Your account requires admin approval</small>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
