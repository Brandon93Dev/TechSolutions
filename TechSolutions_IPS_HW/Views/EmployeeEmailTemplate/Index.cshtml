@model IReadOnlyList<TechSolutions_IPS_HW.Models.Email.EmployeeEmailTemplate>
@using TechSolutions_IPS_HW.Models.ViewModels
@{
    ViewData["Title"] = "My Email Templates";
    var createModel = ViewData["CreateModel"] as EmployeeEmailTemplateFormModel ?? new EmployeeEmailTemplateFormModel();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1"><i class="fa-regular fa-envelope me-2"></i>My Email Templates</h2>
        <p class="text-muted mb-0">Create and manage your private email templates.</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-light fw-semibold">Create Template</div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="Name">Template Name</label>
                    <input id="Name" name="Name" class="form-control" maxlength="120" value="@createModel.Name" />
                </div>
                <div class="col-md-8">
                    <label class="form-label" for="Subject">Subject</label>
                    <input id="Subject" name="Subject" class="form-control" maxlength="200" value="@createModel.Subject" />
                </div>
                <div class="col-lg-6">
                    <label class="form-label" for="BodyHtml">Body HTML</label>
                    <textarea id="BodyHtml" name="BodyHtml" class="form-control employee-template-editor" rows="12" maxlength="20000" data-template-editor="true" data-preview-target="BodyHtmlPreview">@createModel.BodyHtml</textarea>
                    <div class="form-text">Preview updates as you type.</div>
                </div>
                <div class="col-lg-6">
                    <label class="form-label">Preview</label>
                    <iframe id="BodyHtmlPreview" class="employee-template-preview border rounded bg-light w-100" sandbox="" referrerpolicy="no-referrer"></iframe>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    <i class="fa-solid fa-plus me-1"></i>Create
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-light fw-semibold">Saved Templates</div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-muted mb-0">No templates yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Subject</th>
                            <th>Updated</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Subject</td>
                            <td class="text-muted">@item.UpdatedAtUtc.ToString("dd MMM yyyy HH:mm") UTC</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this template?');">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/employee-email-template.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/employee/email-template-editor.js" asp-append-version="true"></script>
}
