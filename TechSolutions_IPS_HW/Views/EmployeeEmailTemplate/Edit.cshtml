@model TechSolutions_IPS_HW.Models.ViewModels.EmployeeEmailTemplateFormModel
@{
    ViewData["Title"] = "Edit Email Template";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1"><i class="fa-solid fa-pen me-2"></i>Edit Email Template</h2>
        <p class="text-muted mb-0">Update your private template.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Back</a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" maxlength="120" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Subject" class="form-label"></label>
                    <input asp-for="Subject" class="form-control" maxlength="200" />
                    <span asp-validation-for="Subject" class="text-danger"></span>
                </div>
                <div class="col-lg-6">
                    <label asp-for="BodyHtml" class="form-label">Body HTML</label>
                    <textarea asp-for="BodyHtml" class="form-control employee-template-editor" rows="12"
                        maxlength="20000" data-template-editor="true" data-preview-target="BodyHtmlPreview"></textarea>
                    <div class="form-text">Preview updates as you type.</div>
                    <span asp-validation-for="BodyHtml" class="text-danger"></span>
                </div>
                <div class="col-lg-6">
                    <label class="form-label">Preview</label>
                    <iframe id="BodyHtmlPreview" class="employee-template-preview border rounded bg-light w-100"
                        sandbox="" referrerpolicy="no-referrer"></iframe>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    <i class="fa-solid fa-floppy-disk me-1"></i>Save
                </button>
            </div>
        </form>
    </div>
</div>

@section Styles {
<link rel="stylesheet" href="~/css/employee-email-template.css" asp-append-version="true" />
}

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script src="~/js/employee/email-template-editor.js" asp-append-version="true"></script>
}
