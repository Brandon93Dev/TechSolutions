@{
    ViewData["Title"] = "Home Page";
}

<div class="home-hero text-center">
    <div class="home-hero-icon">
        <i class="fa-solid fa-shield-halved"></i>
    </div>
    <h1 class="display-5 fw-bold">Welcome to <span class="text-primary">TechSolutions</span></h1>
    <p class="lead text-muted mb-4">Secure Data Management Portal</p>
    <hr class="home-divider mx-auto" />
    <p class="home-description mx-auto">
        TechSolutions is a full Data Management solution, that provides
        <strong>Secure Storage</strong>, <strong>Retrieval</strong> and <strong>Management</strong>
        as well as strict adherence to the
        <a href="https://popia.co.za/" target="_blank" class="text-decoration-none">POPI Act</a>
        set out in 2013.
    </p>

    <div class="home-hero-image-wrap mt-4">
        <img src="~/images/home.png" asp-append-version="true" alt="TechSolutions security illustration" class="img-fluid home-hero-image" />
    </div>
</div>

@if (User.Identity?.IsAuthenticated == true && User.IsInRole("Employee"))
{
    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div class="card-body">
            <h5 class="mb-3"><i class="fa-solid fa-chart-simple me-2 text-primary"></i>Your Customer Metrics</h5>
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="card border-0 bg-light-subtle h-100">
                        <div class="card-body text-center">
                            <div class="fs-3 fw-bold text-info" id="homeMetricTotalCustomers">—</div>
                            <div class="text-muted small">System Total Customers</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 bg-light-subtle h-100">
                        <div class="card-body text-center">
                            <div class="fs-3 fw-bold text-primary" id="homeMetricMyCreated">—</div>
                            <div class="text-muted small">Customers You Created</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 bg-light-subtle h-100">
                        <div class="card-body text-center">
                            <div class="fs-3 fw-bold text-success" id="homeMetricMyActive">—</div>
                            <div class="text-muted small">Your Active Customers</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 bg-light-subtle h-100">
                        <div class="card-body text-center">
                            <div class="fs-3 fw-bold text-warning" id="homeMetricMyDraft">—</div>
                            <div class="text-muted small">Your Draft Customers</div>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-4" />
            <div id="homeLastCreatedCustomer" class="text-muted">Loading your latest customer...</div>
        </div>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

@section Scripts {
    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Employee"))
    {
        <script src="~/js/home/employee-metrics.js" asp-append-version="true"></script>
    }
}
