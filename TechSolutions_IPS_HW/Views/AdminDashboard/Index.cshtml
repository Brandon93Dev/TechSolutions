@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2 class="mb-4"><i class="fa-solid fa-gauge-high me-2"></i>Admin Dashboard</h2>

<div class="row g-3 mb-4" id="employeeOverviewRow">
    <div class="col-md-6">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold text-primary" id="metricTotal">—</div>
                <div class="text-muted"><i class="fa-solid fa-users me-1"></i>Total Employees</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold text-success" id="metricApproved">—</div>
                <div class="text-muted"><i class="fa-solid fa-circle-check me-1"></i>Approved</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold text-warning" id="metricPending">—</div>
                <div class="text-muted"><i class="fa-solid fa-hourglass-half me-1"></i>Pending</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold text-secondary" id="metricMyApprovedEmployees">—</div>
                <div class="text-muted"><i class="fa-solid fa-user-check me-1"></i>Employees You Approved</div>
            </div>
        </div>
    </div>  
</div>


<div class="row g-3 mb-4">
    <div class="col-lg-12">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header">
                <i class="fa-solid fa-globe me-1"></i>Customers by Country
            </div>
            <div class="card-body">
                <canvas id="countryChart" height="120"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm" id="employeeTableSection">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-id-badge me-1"></i>Employees</span>
        <span class="badge bg-secondary" id="employeeCount">0</span>
    </div>
    <div class="card-body p-0" id="employeeTableContainer">
        <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/admin/dashboard.js" asp-append-version="true"></script>
}
