@{
    ViewData["Title"] = "Manage Employees";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="fa-solid fa-user-check me-2"></i>Manage Employees</h2>
</div>

<ul class="nav nav-pills mb-3" id="statusFilter">
    <li class="nav-item">
        <a class="nav-link" href="#" data-status="">All</a>
    </li>
    <li class="nav-item">
        <a class="nav-link active" href="#" data-status="pending">
            <i class="fa-solid fa-hourglass-half me-1"></i>Pending
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="#" data-status="approved">
            <i class="fa-solid fa-circle-check me-1"></i>Approved
        </a>
    </li>
</ul>

<div id="employeesTableContainer">
    <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
</div>

<div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fa-solid fa-circle-check me-1"></i>Action Completed</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="statusModalMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/employees.js" asp-append-version="true"></script>
}
