@model TechSolutions_IPS_HW.Models.Customer.Customer;
@using TechSolutions_IPS_HW.Models.Reference
@{
    var isNew = Model.CustomerId == Guid.Empty;
    ViewData["Title"] = isNew ? "New Customer" : "Edit Customer";

    var countryDialCodes = ViewData["CountryDialCodes"] as IReadOnlyList<CountryDialCode> ?? Array.Empty<CountryDialCode>();

    var hasSelectedCountry = !string.IsNullOrWhiteSpace(Model.Nationality)
        && countryDialCodes.Any(c => string.Equals(c.CountryName, Model.Nationality, StringComparison.OrdinalIgnoreCase));

    var hasSelectedAddressCountry = !string.IsNullOrWhiteSpace(Model.AddressCountry)
        && countryDialCodes.Any(c => string.Equals(c.CountryName, Model.AddressCountry, StringComparison.OrdinalIgnoreCase));
}

<h2 class="mb-1 d-flex align-items-center gap-2">
    @if (isNew)
    {
        <span class="customer-page-icon bg-primary-subtle text-primary"><i class="fa-solid fa-user-plus"></i></span>
        <span>New Customer</span>
    }
    else
    {
        <span class="customer-page-icon bg-warning-subtle text-warning"><i class="fa-solid fa-pen"></i></span>
        <span>Edit Customer</span>
    }
</h2>
<p class="text-muted mb-4 customer-page-subtitle">
    @if (isNew)
    {
        @:Capture customer details and save as draft or activate.
    }
    else
    {
        @:Update customer information and keep records current.
    }
</p>

<div class="row">
    <div class="col-xl-12 col-lg-12">
        
        <div id="formErrors" class="alert alert-danger d-none"></div>

        <form id="customerForm" novalidate>
            <input type="hidden" id="CustomerId" value="@Model.CustomerId" />

            <div class="card border-0 shadow-sm rounded-4 mb-4 customer-form-card">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h5 class="mb-0"><i class="fa-solid fa-user me-2 text-primary"></i>Personal Information</h5>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="FirstName" class="form-label">First Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="FirstName" value="@Model.FirstName" maxlength="150" placeholder="First name" required />
                            <div class="invalid-feedback" data-field="FirstName"></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="Surname" class="form-label">Surname <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="Surname" value="@Model.Surname" maxlength="150" placeholder="Surname" required />
                            <div class="invalid-feedback" data-field="Surname"></div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="Email" value="@Model.Email" maxlength="100" placeholder="email@@example.com" required />
                            <div class="invalid-feedback" data-field="Email"></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="Nationality" class="form-label">Country</label>
                            <select class="form-control" id="Nationality">
                                <option value="">Select or search for a country...</option>
                                @if (!hasSelectedCountry && !string.IsNullOrWhiteSpace(Model.Nationality))
                                {
                                    <option value="@Model.Nationality" selected>@Model.Nationality</option>
                                }
                                @foreach (var country in countryDialCodes)
                                {
                                    if (string.Equals(country.CountryName, Model.Nationality, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="@country.CountryName" data-dial-code="@country.DialCode" selected>@country.CountryName</option>
                                    }
                                    else
                                    {
                                        <option value="@country.CountryName" data-dial-code="@country.DialCode">@country.CountryName</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="Phone" class="form-label">Phone</label>
                            <input type="tel" class="form-control" id="Phone" value="@Model.Phone" maxlength="20" placeholder="+27 12 345 6789" />
                            <div class="invalid-feedback" data-field="Phone"></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="DateOfBirth" class="form-label">Date of Birth</label>
                            <input type="date" class="form-control" id="DateOfBirth" value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="IdNumber" class="form-label">ID / Passport Number</label>
                            <input type="text" class="form-control" id="IdNumber" value="@Model.IdNumber" maxlength="20" placeholder="Required to activate" />
                            <div class="invalid-feedback" data-field="IdNumber"></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="Gender" class="form-label">Gender</label>
                            <select class="form-select" id="Gender">
                                @{
                                    var genderOptions = new[] { "", "Male", "Female", "Other" };
                                    var genderLabels = new[] { "— Select —", "Male", "Female", "Other" };
                                }
                                @for (var i = 0; i < genderOptions.Length; i++)
                                {
                                    if (Model.Gender == genderOptions[i])
                                    {
                                        <option value="@genderOptions[i]" selected>@genderLabels[i]</option>
                                    }
                                    else
                                    {
                                        <option value="@genderOptions[i]">@genderLabels[i]</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4 customer-form-card">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h5 class="mb-0"><i class="fa-solid fa-location-dot me-2 text-primary"></i>Address</h5>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="AddressLine1" class="form-label">Address Line 1</label>
                            <input type="text" class="form-control" id="AddressLine1" value="@Model.AddressLine1" maxlength="200" placeholder="Street address, P.O. box" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="AddressLine2" class="form-label">Address Line 2</label>
                            <input type="text" class="form-control" id="AddressLine2" value="@Model.AddressLine2" maxlength="200" placeholder="Apartment, suite, unit, building" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="City" class="form-label">City</label>
                            <input type="text" class="form-control" id="City" value="@Model.City" maxlength="100" placeholder="City" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="ProvinceState" class="form-label">Province / State</label>
                            <input type="text" class="form-control" id="ProvinceState" value="@Model.ProvinceState" maxlength="100" placeholder="Province or State" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="AddressCountry" class="form-label">Country</label>
                            <select class="form-control" id="AddressCountry">
                                <option value="">Select country...</option>
                                @if (!hasSelectedAddressCountry && !string.IsNullOrWhiteSpace(Model.AddressCountry))
                                {
                                    <option value="@Model.AddressCountry" selected>@Model.AddressCountry</option>
                                }
                                @foreach (var country in countryDialCodes)
                                {
                                    if (string.Equals(country.CountryName, Model.AddressCountry, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="@country.CountryName" selected>@country.CountryName</option>
                                    }
                                    else
                                    {
                                        <option value="@country.CountryName">@country.CountryName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="AreaCode" class="form-label">Area Code</label>
                            <input type="text" class="form-control" id="AreaCode" value="@Model.AreaCode" maxlength="20" placeholder="Postal / Area code" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4 customer-form-card">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h5 class="mb-0"><i class="fa-solid fa-circle-info me-2 text-primary"></i>Additional Information</h5>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="mb-3">
                        <label for="DataSource" class="form-label">Data Source</label>
                        <input type="text" class="form-control" id="DataSource" value="@Model.DataSource" maxlength="200" placeholder="e.g. Walk-in, Referral, Website enquiry" />
                    </div>
                    <div class="mb-3">
                        <label for="Notes" class="form-label">Notes</label>
                        <textarea class="form-control" id="Notes" rows="3" maxlength="1000" placeholder="Any additional notes">@Model.Notes</textarea>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-warning rounded-pill px-4" id="btnSaveDraft">
                    <i class="fa-solid fa-pen-to-square me-1"></i>Save as Draft
                </button>
                <button type="button" class="btn btn-success rounded-pill px-4" id="btnSaveActive">
                    <i class="fa-solid fa-circle-check me-1"></i>Save &amp; Activate
                </button>
                <a asp-action="Index" id="btnCancel" class="btn btn-outline-secondary rounded-pill px-4 ms-auto">
                    <i class="fa-solid fa-arrow-left me-1"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.css" rel="stylesheet">
    <style>
        #customerForm .ts-wrapper.single .ts-control::after,
        #customerForm .ts-wrapper.single.input-active .ts-control::after {
            display: none !important;
        }

        #customerForm .ts-wrapper,
        #customerForm .ts-wrapper .ts-control {
            background-image: none !important;
        }

        #customerForm .ts-wrapper .ts-control {
            min-height: calc(1.5em + .75rem + 2px) !important;
            height: calc(1.5em + .75rem + 2px) !important;
            padding: .375rem .75rem !important;
            display: flex;
            align-items: center;
            border-radius: .375rem;
        }

        #customerForm .ts-wrapper .ts-control > input,
        #customerForm .ts-wrapper .item {
            margin: 0 !important;
            padding: 0 !important;
            line-height: 1.5 !important;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script>
        $(function () {
            function initCountrySelect(selector) {
                var element = document.querySelector(selector);
                if (typeof TomSelect === 'undefined' || !element) return;

                new TomSelect(selector, {
                    maxOptions: 300,
                    searchField: ['text'],
                    sortField: { field: 'text', direction: 'asc' },
                    create: false,
                    placeholder: 'Select or search for a country...',
                    plugins: ['dropdown_input'],
                    openOnFocus: true
                });
            }

            initCountrySelect('#Nationality');
            initCountrySelect('#AddressCountry');
        });
    </script>
    <script src="~/js/customer/edit.js" asp-append-version="true"></script>
}